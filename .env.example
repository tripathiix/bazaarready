# Copy this file to .env and fill in the values. .env is never committed.

# Database (any password you like for local development)
DB_NAME=bazaarready
DB_USER=bazaarready
DB_PASSWORD=

# Domain the app runs on. Leave as localhost on your laptop.
APP_DOMAIN=localhost

# Claude API key from platform.claude.com > Keys
ANTHROPIC_API_KEY=

# Optional key from pexels.com/api. Without it, stock photos come from Wikimedia Commons (no key needed).
PEXELS_API_KEY=

# Optional: "Continue with Google". Google Cloud Console > APIs & Services > Credentials
# > Create OAuth client ID (Web application). Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: the contact form emails support@bazaarready.com through its Titan mailbox.
# SMTP_PASSWORD is that mailbox's password. Leave it empty to only save messages.
SMTP_USERNAME=support@bazaarready.com
SMTP_PASSWORD=
